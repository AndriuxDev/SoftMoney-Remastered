    # game/script-ch1.rpy:247
    old "I'm Harvey. Thanks for meeting me here."
    new "Soy Harvey. Gracias por encontrarte conmigo aquí."

    # game/script-ch1.rpy:249
    old "Harvey?{w=1} That's...{w=1} a unique name."
    new "¿Harvey?{w=1} Eso es...{w=1} un nombre único."

    # game/script-ch1.rpy:252
    old "Haha, yeah. I get that a lot."
    new "Jaja, sí. Eso me lo dicen mucho."

