    # game/script-ch1.rpy:287
    old "Oh, hey!{w=0.5} Look!{w=0.5} See that shop button up top?"
    new "¡Oh, hey!{w=0.5} ¡Mira!{w=0.5} ¿Ves ese botón de tienda arriba?"

